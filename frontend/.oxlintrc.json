{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "vite.config.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "src/main.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
