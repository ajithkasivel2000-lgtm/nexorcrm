PORT=7003
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?schema=public"

# Usernames that manage companies (Platform → Companies). Comma-separated.
PLATFORM_ADMINS=admin

# Production ------------------------------------------------------------------
# NODE_ENV=production
# Listen on localhost only, so nginx is the one way in.
# HOST=127.0.0.1
# The public address. Reset/activation links, webhook and calendar URLs use it.
# APP_URL=https://your-domain.com
# Extra browser origins allowed to call the API cross-origin (comma-separated).
# Same-origin traffic needs no entry; company domains are admitted automatically.
# CORS_EXTRA_ORIGINS=
# Secrets: 32+ random characters each, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ACTIVATION_SECRET=     signs activation links and 2FA login challenges
# WEBHOOK_SECRET=        signs Exotel call-status callback URLs
# SMTP_ALLOW_SELF_SIGNED=false  set true only for a mail server with a self-signed cert (insecure)
#
# First-ever sign-in on an empty database: with SETUP_TOKEN set (16+ characters),
# POST /api/auth/login with { username: "admin", setupToken: "<the value>" }
# creates the first session without seeding. Delete the line once set up.

# Optional ----------------------------------------------------------------------
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@your-domain.com   (browser push)
# ANTHROPIC_API_KEY=         enables the AI assistant
# GOOGLE_CLIENT_ID=          enables Sign in with Google
# GOOGLE_SIGNUP_POLICY=existing

# Meta (WhatsApp + Facebook Lead Ads), when ONE Meta app serves every company.
# Each company can instead enter its own app secret/verify token in
# Settings → Integrations → WhatsApp.
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# File storage: the server's disk by default. Set these to use S3 or any
# S3-compatible store (DigitalOcean Spaces, Cloudflare R2, MinIO).
# S3_BUCKET=  S3_REGION=ap-south-1  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=               only for non-AWS providers
# S3_PREFIX=                 optional folder inside the bucket

# Where new companies copy their email templates from (default: the first company).
# TEMPLATE_COMPANY_ID=CMP-DEFAULT

# SaaS billing (Cashfree) -------------------------------------------------------
# Your platform's Cashfree keys: customers pay you. Without them, plans can still
# be activated by hand under Platform → Companies.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENVIRONMENT=SANDBOX
# General Payment Gateway API version (e.g. payment links); screenshot/docs v4:
# CASHFREE_API_VERSION=2023-08-01
# Subscription API version is separate from the general PG API version:
# CASHFREE_SUBSCRIPTION_API_VERSION=2025-01-01
# CASHFREE_API_URL=https://sandbox.cashfree.com/pg
# CASHFREE_RETURN_URL=https://your-domain.com/payment/success
# CASHFREE_NOTIFY_URL=https://your-domain.com/api/webhooks/cashfree
# For live payments, use freshly rotated Production API keys and set:
# CASHFREE_ENVIRONMENT=PRODUCTION
# CASHFREE_API_URL=https://api.cashfree.com/pg
# Never use Production keys with the Sandbox URL or commit keys to source control.
# If Cashfree returns profile_inactive, merchant activation/KYC and subscription
# enablement must be completed with Cashfree; application code cannot enable it.
# Configure this endpoint in the Cashfree Dashboard for subscription status,
# successful payment, failed payment, and authorisation events.
# TRIAL_DAYS=14
# BILLING_GRACE_DAYS=7          full access after a failed renewal, then expired
# BILLING_GST_PERCENT=18
# ALLOW_COMPANY_SIGNUP=true     "Start a free trial" on the sign-in page; false to close it

# Error monitoring (Sentry) -------------------------------------------------------
# SENTRY_DSN=                   backend errors; nothing is sent without it
# SENTRY_TRACES_SAMPLE_RATE=0
# For the web app, set VITE_SENTRY_DSN when running `npm run build` in frontend/.
