    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
